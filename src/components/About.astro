---
import { type Lang, t, pathFor } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const a = t(lang).about;
const gallery = pathFor(lang, "gallery");
const strip = [
  "/assets/exterior-home-1.jpeg",
  "/assets/kitchen-10.jpeg",
  "/assets/interior-1.jpeg",
  "/assets/deck-2.jpeg",
  "/assets/bathroom-3.jpeg",
];
---

<section id="about">
  <div class="max-w-page mx-auto px-4 md:px-6 py-16 md:py-24 grid lg:grid-cols-[0.9fr_1.1fr] gap-10 lg:gap-16">
    <h2 class="font-display font-bold text-4xl sm:text-5xl tracking-tight leading-[1.05]" style="text-wrap: balance">{a.title}</h2>
    <div class="text-lg leading-relaxed text-slate space-y-5 max-w-[38rem]">
      <p>{a.p1}</p>
      <p>{a.p2}</p>
      <p class="text-ink font-medium">{a.p3}</p>
    </div>
  </div>

  <div class="max-w-page mx-auto px-4 md:px-6 pb-16 md:pb-24">
    <div class="flex items-end justify-between gap-4 mb-5">
      <h3 class="font-display font-bold text-2xl tracking-tight">{a.recent}</h3>
      <a href={gallery} class="font-semibold text-tape-ink underline underline-offset-4 decoration-2 hover:decoration-tape text-right">{a.seeAll}</a>
    </div>
    <ul class="grid grid-cols-2 sm:grid-cols-5 gap-2 sm:gap-3">
      {strip.map((src, i) => (
        <li class={i === 0 ? "col-span-2 sm:col-span-1" : ""}>
          <a href={gallery} class="block overflow-hidden rounded">
            <img src={src} alt={a.stripAlts[i]} loading="lazy" class={`w-full ${i === 0 ? "aspect-[4/3] sm:aspect-[4/5]" : "aspect-[4/5]"} object-cover hover:scale-[1.03] transition-transform duration-300`} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
