---
import { type Lang, t, pathFor } from "../i18n";

interface Props {
  lang: Lang;
  page?: "" | "gallery";
}

const { lang, page = "" } = Astro.props;
const n = t(lang).nav;
const home = pathFor(lang);
const other: Lang = lang === "en" ? "es" : "en";
const links = [
  { href: `${home}#services`, label: n.services },
  { href: `${home}#about`, label: n.about },
  { href: pathFor(lang, "gallery"), label: n.work },
  { href: `${home}#contact`, label: n.contact },
];
---

<header class="fixed top-0 inset-x-0 z-50 bg-plaster/95 backdrop-blur border-b border-line">
  <div class="max-w-page mx-auto px-4 md:px-6 h-16 flex items-center justify-between gap-4">
    <a href={home} class="flex items-center gap-2.5 shrink-0" aria-label={n.home}>
      <img src="/assets/logo-mark.svg" alt="" width="74" height="50" class="h-[50px] w-auto" />
      <span class="font-display font-bold text-lg leading-none tracking-tight hidden sm:inline">FF Handyman Services</span>
    </a>

    <div class="flex items-center gap-1 md:gap-7">
      <nav aria-label={n.menu} class="hidden md:flex items-center gap-7">
        {links.map((l) => (
          <a href={l.href} class="text-[0.98rem] font-medium text-slate hover:text-ink">{l.label}</a>
        ))}
      </nav>
      <a
        href={pathFor(other, page)}
        hreflang={other}
        lang={other}
        aria-label={n.switchAria}
        class="lang-switch text-[0.95rem] font-semibold text-tape-ink rounded border border-line px-3 py-1.5 hover:border-tape-ink"
      >{n.switchLabel}</a>
      <div class="hidden md:block">
        <a href={`${home}#contact`} class="btn btn-primary !py-2.5 !px-4 !text-[0.95rem] whitespace-nowrap">{n.estimate}</a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="md:hidden -mr-2 p-2 rounded"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="sr-only">{n.menu}</span>
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="menu-open" d="M4 7h16M4 12h16M4 17h16" />
          <path class="menu-close hidden" d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label={n.menu} class="md:hidden hidden border-t border-line bg-plaster">
    <ul class="px-4 py-2">
      {links.map((l) => (
        <li><a href={l.href} class="block py-3.5 text-lg font-medium border-b border-line">{l.label}</a></li>
      ))}
    </ul>
    <div class="px-4 pb-5 pt-2">
      <a href={`${home}#contact`} class="btn btn-primary w-full">{n.estimateLong}</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.querySelector(".menu-open")?.classList.toggle("hidden", open);
    toggle?.querySelector(".menu-close")?.classList.toggle("hidden", !open);
  };
  toggle?.addEventListener("click", () => setOpen(menu?.classList.contains("hidden") ?? false));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>
