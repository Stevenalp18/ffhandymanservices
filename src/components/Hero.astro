---
import { type Lang, t, pathFor } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const { hero: h, areas, areaLabel } = t(lang);
---

<section class="pt-16 overflow-hidden">
  <div class="max-w-page mx-auto px-4 md:px-6 pt-10 pb-16 md:pt-16 md:pb-24 grid lg:grid-cols-[1fr_1.05fr] gap-12 lg:gap-10 items-center">
    <div class="max-w-xl">
      <h1 class:list={[
        "font-display font-extrabold leading-[1.02] tracking-tight",
        lang === "es" ? "text-[2.3rem] sm:text-[3.4rem]" : "text-[2.6rem] sm:text-6xl",
      ]} style="text-wrap: balance">
        {h.title}
      </h1>
      <p class="mt-6 text-lg sm:text-xl leading-relaxed text-slate max-w-[34rem]">{h.body}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#contact" class="btn btn-primary">{h.cta}</a>
        <a href={pathFor(lang, "gallery")} class="btn btn-quiet">{h.secondary}</a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-5 gap-y-2 text-[0.95rem] text-slate" aria-label={areaLabel}>
        {areas.map((a) => (
          <li class="flex items-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1E61AB" stroke-width="3" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {a}
          </li>
        ))}
      </ul>
    </div>

    <!-- Job photos taped up like they would be on a site board -->
    <div class="relative h-[27rem] sm:h-[36rem] lg:h-[37rem] w-full max-w-[36rem] mx-auto lg:mx-0" aria-label={h.photosLabel}>
      <figure class="photo absolute left-0 top-4 w-[74%] rotate-[-2deg]">
        <span class="tape -top-3 left-6 rotate-[-8deg]"></span>
        <span class="tape -top-3 right-8 rotate-[6deg]"></span>
        <img src="/assets/kitchen-remodel-1.jpeg" alt={h.alts[0]} class="w-full aspect-[4/3] object-cover" loading="eager" />
        <figcaption>{h.captions[0]}</figcaption>
      </figure>
      <figure class="photo absolute right-0 top-[30%] w-[42%] rotate-[3deg]">
        <span class="tape -top-3 left-1/2 -translate-x-1/2 rotate-[-3deg] !w-20"></span>
        <img src="/assets/bathroom-renovation-1.jpeg" alt={h.alts[1]} class="w-full aspect-[3/4] object-cover" loading="eager" />
        <figcaption>{h.captions[1]}</figcaption>
      </figure>
      <figure class="photo absolute left-[6%] bottom-0 w-[46%] rotate-[1.5deg]">
        <span class="tape -top-3 left-4 rotate-[-12deg] !w-20"></span>
        <img src="/assets/deck-work-1.jpeg" alt={h.alts[2]} class="w-full aspect-[4/3] object-cover" loading="eager" />
        <figcaption>{h.captions[2]}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .photo {
    background: #fff;
    padding: 0.55rem 0.55rem 0;
    box-shadow: 0 1px 1px rgba(29, 42, 48, 0.08), 0 10px 28px -8px rgba(29, 42, 48, 0.28);
  }
  .photo figcaption {
    font-size: 0.82rem;
    font-weight: 500;
    color: #4a6270;
    padding: 0.5rem 0.15rem 0.6rem;
  }
  /* The one load moment: each strip of tape presses down onto its photo. */
  @media (prefers-reduced-motion: no-preference) {
    .photo { animation: settle 520ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
    .photo:nth-of-type(2) { animation-delay: 120ms; }
    .photo:nth-of-type(3) { animation-delay: 240ms; }
    .photo .tape { animation: stick 260ms ease-out both; animation-delay: inherit; }
  }
  @keyframes settle {
    from { opacity: 0; translate: 0 14px; }
    to { opacity: 1; translate: 0 0; }
  }
  @keyframes stick {
    0%, 60% { opacity: 0; scale: 1.25; }
    100% { opacity: 1; scale: 1; }
  }
</style>
